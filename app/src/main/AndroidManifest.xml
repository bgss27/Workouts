<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Health Connect: write strength-training sessions to the system store. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <!-- Visibility for the Health Connect provider on Android 11+.
         Pre-Android 14 ships Health Connect as a standalone app under
         com.google.android.apps.healthdata. Android 14+ moves it into the
         system module, so the package query alone isn't enough — the
         intent-based query covers both provider variants. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:name=".FitTrackApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="FitTrack"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitTrack">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FitTrack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Pre-Android 14 Health Connect rationale (older standalone app). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- Tells Health Connect which health permissions FitTrack declares.
                 Android 14+ system Health Connect refuses to grant if this is missing. -->
            <meta-data
                android:name="health_permissions"
                android:resource="@array/health_permissions" />
        </activity>

        <!-- Android 14+ system Health Connect rationale. The activity-alias
             pattern is what the system uses to launch the app's permission
             rationale screen; without it, the grant flow hangs at "requesting
             access" because HC can't validate the app handles rationale display. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
